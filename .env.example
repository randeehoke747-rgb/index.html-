# Example environment variables for local development
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppassword
POSTGRES_DB=appdb
DB_PORT=5432

# Example DATABASE_URL (use when your app needs a single connection string)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${DB_PORT}/${POSTGRES_DB}

# Ethereum Blockchain Configuration
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ETHEREUM_CHAIN_ID=1

# Safe Recovery Wallet (USDC) - Titan Security System
SAFE_WALLET_ADDRESS=0xCE4A926070c0544052de1E56d1254eaac79b77be

# USDC Token Contract (Ethereum Mainnet)
USDC_CONTRACT_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48

# Monitoring Configuration
SITE_MONITOR_INTERVAL=300
TRANSACTION_MONITOR_INTERVAL=60
KEY_COMPROMISE_ALERT_THRESHOLD=2

# Security Agent Settings
AGENT_PRIVATE_KEY_ENCRYPTED=your_encrypted_private_key_here
AGENT_LOG_LEVEL=INFO

# Client Authorization
CLIENT_AUTH_REQUIRED=true
REQUIRE_SIGNATURE_VERIFICATION=true
